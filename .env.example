# Copy to .env and adjust. Values below are for local development only.

# Postgres from `docker compose up -d postgres` (host port 5433)
DATABASE_URL="postgresql://readly:readly@localhost:5433/readly"
# Used by integration tests (database created by docker/postgres-init)
TEST_DATABASE_URL="postgresql://readly:readly@localhost:5433/readly_test"

# AI provider: "mock" (no network, deterministic) or "gemini"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Seed accounts (local test values, not real credentials)
SEED_ADMIN_EMAIL="admin@readly.local"
SEED_ADMIN_PASSWORD="readly-admin-123"
# Also seed a demo teacher (giaovien@readly.local / readly-gv-123), class code DEMO12
# and a demo student in that class (hocsinh@readly.local / readly-hs-123)
SEED_DEMO="true"

# Web push (optional). Without keys, notifications stay in the in-app bell.
# Generate a pair with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
# Contact the push services can reach (mailto: or https: URL)
WEB_PUSH_SUBJECT="mailto:admin@readly.local"
