// Readly – data model.
// Phase 1: accounts, sessions, classes, class membership, reading settings.
// Phase 2: works, tags, segments, interest quiz results.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ReadingTheme {
  LIGHT
  SEPIA
  DARK
}

enum MembershipEndReason {
  SWITCHED // student joined another class with a new code
  REMOVED // teacher removed the student
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  memberships   ClassMembership[]
  classesTaught Class[]
  settings      UserSettings?
  quizResults   QuizResult[]
}

/// Database session. `id` is the SHA-256 hash of the cookie token,
/// so a leaked database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Class {
  id         String   @id @default(cuid())
  name       String
  /// Join code students type when registering or switching class.
  code       String   @unique
  codeActive Boolean  @default(true)
  teacherId  String
  createdAt  DateTime @default(now())

  teacher     User              @relation(fields: [teacherId], references: [id])
  memberships ClassMembership[]

  @@index([teacherId])
}

/// Membership history. A student has at most one active membership
/// (leftAt IS NULL) – enforced by a partial unique index in the migration.
model ClassMembership {
  id        String               @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime             @default(now())
  leftAt    DateTime?
  endReason MembershipEndReason?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, leftAt])
  @@index([studentId, leftAt])
}

// ───────────────────────── Content (phase 2) ─────────────────────────

enum Genre {
  THO // thơ
  TRUYEN_NGAN // truyện ngắn
  TIEU_THUYET // tiểu thuyết
  KICH // kịch
  KI // kí
  NGHI_LUAN // nghị luận
}

enum WorkStatus {
  DRAFT // only admins see it
  PUBLISHED // readable
  COMING_SOON // listed in the library with a "Sắp có" badge
}

enum TagKind {
  THEME // chủ đề
  MOOD // không khí
}

model Work {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  author      String
  authorBio   String
  genre       Genre
  summary     String
  /// 1 = Dễ, 2 = Vừa, 3 = Khó
  difficulty  Int
  estMinutes  Int
  status      WorkStatus @default(DRAFT)
  /// Optional cover image; a generated placeholder cover is shown when null.
  coverUrl    String?
  /// Lower-case, diacritic-free "title author" for accent-insensitive search.
  searchText  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tags     WorkTag[]
  segments Segment[]

  @@index([status, genre])
}

model Tag {
  id    String  @id @default(cuid())
  slug  String  @unique
  label String
  kind  TagKind

  works WorkTag[]
}

model WorkTag {
  workId String
  tagId  String

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@index([tagId])
}

/// A meaningful reading unit chosen by the admin (stanza, scene, part…).
model Segment {
  id         String    @id @default(cuid())
  workId     String
  order      Int
  title      String?
  /// Sanitised HTML.
  content    String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, order])
}

/// One submission of the interest quiz; the latest one drives recommendations.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  /// { [questionId]: optionId }
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSettings {
  userId     String       @id
  fontSize   Int          @default(18)
  lineHeight Float        @default(1.7)
  theme      ReadingTheme @default(LIGHT)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
