// Readly – data model.
// Phase 1: accounts, sessions, classes, class membership, reading settings.
// Phase 2: works, tags, segments, interest quiz results.
// Phase 3: reading progress, segment reads, reading time, highlights.
// Phase 4: questions, answers (AI grading), work completion.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ReadingFont {
  NOTO_SERIF
  LORA
  BE_VIETNAM
}

enum PageMode {
  SCROLL
  PAGED
}

enum ReadingTheme {
  LIGHT
  SEPIA
  DARK
}

enum MembershipEndReason {
  SWITCHED // student joined another class with a new code
  REMOVED // teacher removed the student
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  memberships   ClassMembership[]
  classesTaught Class[]
  settings      UserSettings?
  quizResults   QuizResult[]
  progress      ReadingProgress[]
  segmentReads  SegmentRead[]
  readingTimes  ReadingTime[]
  highlights    Highlight[]
  answers       Answer[]
  completions   WorkCompletion[]
}

/// Database session. `id` is the SHA-256 hash of the cookie token,
/// so a leaked database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Class {
  id         String   @id @default(cuid())
  name       String
  /// Join code students type when registering or switching class.
  code       String   @unique
  codeActive Boolean  @default(true)
  teacherId  String
  createdAt  DateTime @default(now())

  teacher     User              @relation(fields: [teacherId], references: [id])
  memberships ClassMembership[]

  @@index([teacherId])
}

/// Membership history. A student has at most one active membership
/// (leftAt IS NULL) – enforced by a partial unique index in the migration.
model ClassMembership {
  id        String               @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime             @default(now())
  leftAt    DateTime?
  endReason MembershipEndReason?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, leftAt])
  @@index([studentId, leftAt])
}

// ───────────────────────── Content (phase 2) ─────────────────────────

enum Genre {
  THO // thơ
  TRUYEN_NGAN // truyện ngắn
  TIEU_THUYET // tiểu thuyết
  KICH // kịch
  KI // kí
  NGHI_LUAN // nghị luận
}

enum WorkStatus {
  DRAFT // only admins see it
  PUBLISHED // readable
  COMING_SOON // listed in the library with a "Sắp có" badge
}

enum TagKind {
  THEME // chủ đề
  MOOD // không khí
}

model Work {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  author     String
  authorBio  String
  genre      Genre
  summary    String
  /// 1 = Dễ, 2 = Vừa, 3 = Khó
  difficulty Int
  estMinutes Int
  status     WorkStatus @default(DRAFT)
  /// "Trước khi đọc" background card (author, context) – sanitised HTML.
  background String?
  /// Optional cover image; a generated placeholder cover is shown when null.
  coverUrl   String?
  /// Lower-case, diacritic-free "title author" for accent-insensitive search.
  searchText String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tags        WorkTag[]
  segments    Segment[]
  progress    ReadingProgress[]
  highlights  Highlight[]
  questions   Question[]
  completions WorkCompletion[]

  @@index([status, genre])
}

model Tag {
  id    String  @id @default(cuid())
  slug  String  @unique
  label String
  kind  TagKind

  works WorkTag[]
}

model WorkTag {
  workId String
  tagId  String

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@index([tagId])
}

/// A meaningful reading unit chosen by the admin (stanza, scene, part…).
model Segment {
  id         String    @id @default(cuid())
  workId     String
  order      Int
  title      String?
  /// Sanitised HTML.
  content    String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  work         Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  progress     ReadingProgress[]
  reads        SegmentRead[]
  readingTimes ReadingTime[]
  highlights   Highlight[]
  questions    Question[]

  @@index([workId, order])
}

/// One submission of the interest quiz; the latest one drives recommendations.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  /// { [questionId]: optionId }
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Reading (phase 3) ─────────────────────────

/// Where the student is in a work; synced across devices.
model ReadingProgress {
  userId          String
  workId          String
  segmentId       String?
  /// 0..1 – how far into `segmentId` the top of the viewport was.
  segmentFraction Float    @default(0)
  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work    Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@id([userId, workId])
  @@index([userId, updatedAt])
}

/// A segment counts as read once its end has been on screen.
model SegmentRead {
  userId    String
  segmentId String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([userId, segmentId])
  @@index([segmentId])
}

/// Active reading time per segment per Vietnam calendar day (teacher-only metric).
model ReadingTime {
  userId    String
  segmentId String
  /// Calendar day in Asia/Ho_Chi_Minh, stored as UTC midnight of that date.
  day       DateTime @db.Date
  seconds   Int      @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([userId, segmentId, day])
  @@index([segmentId])
}

enum HighlightColor {
  YELLOW // ấn tượng
  BLUE // thắc mắc
  PINK // cảm xúc
  PURPLE // nghệ thuật
}

/// Offsets index into the segment's plain-text model (see src/lib/reading/text-model.ts).
/// quote/prefix/suffix let us re-anchor the highlight if the text is edited later.
model Highlight {
  id        String         @id @default(cuid())
  userId    String
  workId    String
  segmentId String
  start     Int
  end       Int
  quote     String
  prefix    String
  suffix    String
  color     HighlightColor @default(YELLOW)
  note      String?
  isPrivate Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  work    Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([userId, workId])
  @@index([segmentId])
}

// ───────────────────────── Questions & AI (phase 4) ─────────────────────────

enum QuestionStage {
  PRE // trước khi đọc
  DURING // trong khi đọc (gắn với một phân đoạn)
  POST // sau khi đọc
}

enum QuestionType {
  PREDICTION // dự đoán mở – không chấm, AI so sánh sau khi đọc xong
  MCQ // trắc nghiệm – chấm tự động
  SHORT // tự luận ngắn – AI chấm theo rubric
  ESSAY // đoạn cảm nhận – AI chấm theo rubric
}

/// Questions are authored ahead of time and fixed once published (no live generation).
model Question {
  id              String        @id @default(cuid())
  workId          String
  /// Required for DURING questions.
  segmentId       String?
  stage           QuestionStage
  type            QuestionType
  order           Int           @default(0)
  prompt          String
  required        Boolean       @default(true)
  /// MCQ: [{ id, text }]
  options         Json?
  correctOptionId String?
  /// MCQ: shown after answering.
  explanation     String?
  /// SHORT/ESSAY: { chuaDat, dat, sauSac } – what each level looks like.
  rubric          Json?
  /// SHORT/ESSAY: ideas a good answer covers.
  keyPoints       String[]      @default([])
  /// ESSAY: static outline shown to the student.
  outline         String?
  minWords        Int?
  maxWords        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  work    Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  answers Answer[]

  @@index([workId, stage, order])
  @@index([segmentId])
}

enum AnswerStatus {
  PENDING // waiting for AI feedback
  GRADED
  FAILED // AI gave up after retries – does not count as an attempt
}

enum AnswerLevel {
  CHUA_DAT
  DAT
  SAU_SAC
}

/// One submission. `attempt` is the submission number; only GRADED rows
/// count towards the 3-attempt limit.
model Answer {
  id           String       @id @default(cuid())
  questionId   String
  userId       String
  attempt      Int
  /// Text for open questions, option id for MCQ.
  content      String
  status       AnswerStatus
  level        AnswerLevel?
  isCorrect    Boolean?
  strengths    String?
  improvements String?
  /// PREDICTION: AI comparison with the actual work, written after completion.
  feedback     String?
  /// Teacher controls (phase 6).
  aiHidden     Boolean      @default(false)
  teacherLevel AnswerLevel?
  teacherNote  String?
  submittedAt  DateTime     @default(now())
  gradedAt     DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId, attempt])
  @@index([userId, submittedAt])
  @@index([status])
}

/// Written once, when all segments are read and every required question is resolved.
model WorkCompletion {
  userId      String
  workId      String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
  @@index([workId])
}

model UserSettings {
  userId     String       @id
  fontSize   Int          @default(18)
  lineHeight Float        @default(1.7)
  theme      ReadingTheme @default(LIGHT)
  /// Reading typeface (see src/lib/reading/appearance.ts).
  font       ReadingFont  @default(NOTO_SERIF)
  /// Decorative reader background id, "none" for a plain theme colour.
  backdrop   String       @default("none")
  pageMode   PageMode     @default(SCROLL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
