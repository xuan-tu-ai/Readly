// Readly – data model.
// Phase 1: accounts, sessions, classes, class membership, reading settings.
// Phase 2: works, tags, segments, interest quiz results.
// Phase 3: reading progress, segment reads, reading time, highlights.
// Phase 4: questions, answers (AI grading), work completion.
// Phase 5: gamification. Phase 6: assignments, teacher review, notifications.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ReadingFont {
  NOTO_SERIF
  LORA
  BE_VIETNAM
}

enum PageMode {
  SCROLL
  PAGED
}

enum ReadingTheme {
  LIGHT
  SEPIA
  DARK
}

enum MembershipEndReason {
  SWITCHED // student joined another class with a new code
  REMOVED // teacher removed the student
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  memberships     ClassMembership[]
  classesTaught   Class[]
  settings        UserSettings?
  quizResults     QuizResult[]
  progress        ReadingProgress[]
  segmentReads    SegmentRead[]
  readingTimes    ReadingTime[]
  highlights      Highlight[]
  answers         Answer[]
  completions     WorkCompletion[]
  pointEntries    PointEntry[]
  streakDays      StreakDay[]
  badges          UserBadge[]
  gamePlays       MiniGamePlay[]
  player          PlayerState?
  notifications   Notification[]    @relation("NotificationRecipient")
  sentNotices     Notification[]    @relation("NotificationSender")
  reviewedAnswers Answer[]          @relation("AnswerReviewer")
  aiReports       AiReport[]
}

/// Database session. `id` is the SHA-256 hash of the cookie token,
/// so a leaked database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Class {
  id                 String   @id @default(cuid())
  name               String
  /// Join code students type when registering or switching class.
  code               String   @unique
  codeActive         Boolean  @default(true)
  /// Weekly class leaderboard (spec §8.2): on by default, the teacher can turn it off.
  leaderboardEnabled Boolean  @default(true)
  teacherId          String
  createdAt          DateTime @default(now())

  teacher     User              @relation(fields: [teacherId], references: [id])
  memberships ClassMembership[]
  assignments Assignment[]

  @@index([teacherId])
}

/// Membership history. A student has at most one active membership
/// (leftAt IS NULL) – enforced by a partial unique index in the migration.
model ClassMembership {
  id        String               @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime             @default(now())
  leftAt    DateTime?
  endReason MembershipEndReason?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, leftAt])
  @@index([studentId, leftAt])
}

// ───────────────────────── Content (phase 2) ─────────────────────────

enum Genre {
  THO // thơ
  TRUYEN_NGAN // truyện ngắn
  TIEU_THUYET // tiểu thuyết
  KICH // kịch
  KI // kí
  NGHI_LUAN // nghị luận
}

enum WorkStatus {
  DRAFT // only admins see it
  PUBLISHED // readable
  COMING_SOON // listed in the library with a "Sắp có" badge
}

enum TagKind {
  THEME // chủ đề
  MOOD // không khí
}

model Work {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  author     String
  authorBio  String
  genre      Genre
  summary    String
  /// 1 = Dễ, 2 = Vừa, 3 = Khó
  difficulty Int
  estMinutes Int
  status     WorkStatus @default(DRAFT)
  /// "Trước khi đọc" background card (author, context) – sanitised HTML.
  background String?
  /// Optional cover image; a generated placeholder cover is shown when null.
  coverUrl   String?
  /// Lower-case, diacritic-free "title author" for accent-insensitive search.
  searchText String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tags        WorkTag[]
  segments    Segment[]
  progress    ReadingProgress[]
  highlights  Highlight[]
  questions   Question[]
  completions WorkCompletion[]
  badges      BadgeDefinition[]
  miniGames   MiniGame[]
  assignments Assignment[]

  @@index([status, genre])
}

model Tag {
  id    String  @id @default(cuid())
  slug  String  @unique
  label String
  kind  TagKind

  works WorkTag[]
}

model WorkTag {
  workId String
  tagId  String

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@index([tagId])
}

/// A meaningful reading unit chosen by the admin (stanza, scene, part…).
model Segment {
  id         String    @id @default(cuid())
  workId     String
  order      Int
  title      String?
  /// Sanitised HTML.
  content    String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  work         Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  progress     ReadingProgress[]
  reads        SegmentRead[]
  readingTimes ReadingTime[]
  highlights   Highlight[]
  questions    Question[]
  /// Mini games that open once this segment has been read.
  unlocksGames MiniGame[]

  @@index([workId, order])
}

/// One submission of the interest quiz; the latest one drives recommendations.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  /// { [questionId]: optionId }
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Reading (phase 3) ─────────────────────────

/// Where the student is in a work; synced across devices.
model ReadingProgress {
  userId          String
  workId          String
  segmentId       String?
  /// 0..1 – how far into `segmentId` the top of the viewport was.
  segmentFraction Float    @default(0)
  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work    Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@id([userId, workId])
  @@index([userId, updatedAt])
}

/// A segment counts as read once its end has been on screen.
model SegmentRead {
  userId    String
  segmentId String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([userId, segmentId])
  @@index([segmentId])
}

/// Active reading time per segment per Vietnam calendar day (teacher-only metric).
model ReadingTime {
  userId    String
  segmentId String
  /// Calendar day in Asia/Ho_Chi_Minh, stored as UTC midnight of that date.
  day       DateTime @db.Date
  seconds   Int      @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([userId, segmentId, day])
  @@index([segmentId])
}

enum HighlightColor {
  YELLOW // ấn tượng
  BLUE // thắc mắc
  PINK // cảm xúc
  PURPLE // nghệ thuật
}

/// Offsets index into the segment's plain-text model (see src/lib/reading/text-model.ts).
/// quote/prefix/suffix let us re-anchor the highlight if the text is edited later.
model Highlight {
  id        String         @id @default(cuid())
  userId    String
  workId    String
  segmentId String
  start     Int
  end       Int
  quote     String
  prefix    String
  suffix    String
  color     HighlightColor @default(YELLOW)
  note      String?
  isPrivate Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  work    Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([userId, workId])
  @@index([segmentId])
}

// ───────────────────────── Questions & AI (phase 4) ─────────────────────────

enum QuestionStage {
  PRE // trước khi đọc
  DURING // trong khi đọc (gắn với một phân đoạn)
  POST // sau khi đọc
}

enum QuestionType {
  PREDICTION // dự đoán mở – không chấm, AI so sánh sau khi đọc xong
  MCQ // trắc nghiệm – chấm tự động
  SHORT // tự luận ngắn – AI chấm theo rubric
  ESSAY // đoạn cảm nhận – AI chấm theo rubric
}

/// Questions are authored ahead of time and fixed once published (no live generation).
model Question {
  id              String        @id @default(cuid())
  workId          String
  /// Required for DURING questions.
  segmentId       String?
  stage           QuestionStage
  type            QuestionType
  order           Int           @default(0)
  prompt          String
  required        Boolean       @default(true)
  /// MCQ: [{ id, text }]
  options         Json?
  correctOptionId String?
  /// MCQ: shown after answering.
  explanation     String?
  /// SHORT/ESSAY: { chuaDat, dat, sauSac } – what each level looks like.
  rubric          Json?
  /// SHORT/ESSAY: ideas a good answer covers.
  keyPoints       String[]      @default([])
  /// ESSAY: static outline shown to the student.
  outline         String?
  minWords        Int?
  maxWords        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  work    Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  answers Answer[]

  @@index([workId, stage, order])
  @@index([segmentId])
}

enum AnswerStatus {
  PENDING // waiting for AI feedback
  GRADED
  FAILED // AI gave up after retries – does not count as an attempt
}

enum AnswerLevel {
  CHUA_DAT
  DAT
  SAU_SAC
}

/// One submission. `attempt` is the submission number; only GRADED rows
/// count towards the 3-attempt limit.
model Answer {
  id           String       @id @default(cuid())
  questionId   String
  userId       String
  attempt      Int
  /// Text for open questions, option id for MCQ.
  content      String
  status       AnswerStatus
  level        AnswerLevel?
  isCorrect    Boolean?
  strengths    String?
  improvements String?
  /// PREDICTION: AI comparison with the actual work, written after completion.
  feedback     String?
  /// Teacher controls (phase 6).
  aiHidden     Boolean      @default(false)
  teacherLevel AnswerLevel?
  teacherNote  String?
  submittedAt  DateTime     @default(now())
  gradedAt     DateTime?

  /// Last time a teacher reviewed this answer (level, note or hiding the AI text).
  reviewedAt DateTime?
  reviewerId String?

  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?      @relation("AnswerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reports  AiReport[]

  @@unique([questionId, userId, attempt])
  @@index([userId, submittedAt])
  @@index([status])
}

/// Written once, when all segments are read and every required question is resolved.
model WorkCompletion {
  userId      String
  workId      String
  completedAt DateTime @default(now())
  /// Completed on or before the deadline of a teacher assignment (+bonus points).
  /// Fixed at completion time, so a later deadline change never takes points back.
  onTime      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
  @@index([workId])
}

model UserSettings {
  userId     String       @id
  fontSize   Int          @default(18)
  lineHeight Float        @default(1.7)
  theme      ReadingTheme @default(LIGHT)
  /// Reading typeface (see src/lib/reading/appearance.ts).
  font       ReadingFont  @default(NOTO_SERIF)
  /// Decorative reader background id, "none" for a plain theme colour.
  backdrop   String       @default("none")
  pageMode   PageMode     @default(SCROLL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Gamification (spec §8) ─────────────────────────

enum PointReason {
  MCQ
  SHORT
  ESSAY
  WORK_COMPLETED
  MINIGAME
}

/// Append-only point ledger. Every source of points has a key
/// ("question:<id>", "work:<id>", "game:<id>"); awarding writes the difference
/// between what the source is worth now and what the key already holds, so
/// regrades, teacher overrides and new mini game records correct themselves.
model PointEntry {
  id        String      @id @default(cuid())
  userId    String
  key       String
  reason    PointReason
  /// Positive, or negative for a correction.
  amount    Int
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, key])
  @@index([userId, createdAt])
}

/// Point table and level thresholds (one row, id = 1). Admin edits it in phase 8;
/// changing it triggers a recalculation of every ledger.
model GamificationConfig {
  id              Int      @id @default(1)
  mcqFirstTry     Int      @default(5)
  shortDat        Int      @default(10)
  shortSauSac     Int      @default(20)
  essayDat        Int      @default(20)
  essaySauSac     Int      @default(40)
  workCompleted   Int      @default(100)
  workEarlyBonus  Int      @default(50)
  miniGameMax     Int      @default(30)
  levelThresholds Int[]    @default([0, 300, 1000, 2500, 5000])
  updatedAt       DateTime @updatedAt
}

/// A Vietnam calendar day with at least one meaningful interaction (spec §8.3).
model StreakDay {
  userId String
  /// Calendar day in Asia/Ho_Chi_Minh, stored as UTC midnight of that date.
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// Per-student state that is not derived from the ledger.
model PlayerState {
  userId          String  @id
  /// Highest level already celebrated, so a level-up is shown once.
  celebratedLevel Int     @default(1)
  /// Key from src/lib/art.ts (AVATARS); null = picked from the user id.
  avatar          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BadgeRule {
  /// Complete N works.
  WORKS_COMPLETED
  /// Complete works in N different genres.
  GENRES_COMPLETED
  /// Read N days in a row.
  STREAK_DAYS
  /// N answers rated Sâu sắc.
  DEEP_ANSWERS
  /// Complete one specific work.
  WORK_COMPLETED
}

model BadgeDefinition {
  id          String    @id @default(cuid())
  /// Stable key for seeded badges; null for badges the admin creates.
  key         String?   @unique
  name        String
  description String
  rule        BadgeRule
  threshold   Int?
  workId      String?
  /// Art keys from src/lib/art.ts (BADGE_EMBLEMS, BADGE_TIERS).
  emblem      String
  tier        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  work   Work?       @relation(fields: [workId], references: [id], onDelete: Cascade)
  awards UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime  @default(now())
  /// Set once the student has seen the "new badge" celebration.
  seenAt    DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([badgeId])
}

enum MiniGameType {
  /// Ghép nhân vật – sự kiện
  MATCH
  /// Đoán chi tiết trong đoạn văn
  DETAIL
}

model MiniGame {
  id              String       @id @default(cuid())
  workId          String
  /// Opens only after the student has read this segment (no spoilers).
  unlockSegmentId String
  type            MiniGameType
  title           String
  /// Shape depends on `type`; see src/lib/minigames.ts.
  data            Json
  published       Boolean      @default(true)
  order           Int          @default(0)
  createdAt       DateTime     @default(now())

  work          Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  unlockSegment Segment        @relation(fields: [unlockSegmentId], references: [id], onDelete: Cascade)
  plays         MiniGamePlay[]

  @@index([workId])
}

model MiniGamePlay {
  id       String   @id @default(cuid())
  userId   String
  gameId   String
  correct  Int
  total    Int
  playedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game MiniGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

// ───────────────────────── Teacher (spec §10) ─────────────────────────

/// A work the teacher asks a class to read by a deadline. Completion rates,
/// reminders and the report are computed against these.
model Assignment {
  id        String   @id @default(cuid())
  classId   String
  workId    String
  /// End of the due day in Vietnam time (23:59:59.999 +07:00).
  dueAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  work  Work  @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([classId, workId])
  @@index([classId, dueAt])
}

/// A teacher flags AI feedback so the admin reviews the question's rubric (spec §6.5).
model AiReport {
  id         String    @id @default(cuid())
  answerId   String
  reporterId String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([answerId, reporterId])
  @@index([resolvedAt, createdAt])
}

// ───────────────────────── Notifications (spec §11) ─────────────────────────

/// Same kinds as NOTIFICATION_KINDS in src/lib/art.ts (icons).
enum NotificationKind {
  ASSIGNMENT
  REMINDER
  GRADED
  TEACHER_REVIEW
  BADGE
  REPLY
  LEVEL_UP
  STREAK
}

/// In-app notification. Phase 6 writes assignment and reminder notices;
/// phase 7 adds the bell, web push and the other sources.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  /// In-app link opened from the notification.
  href      String?
  /// Who triggered it (the teacher, for reminders).
  senderId  String?
  workId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workId, kind])
}
