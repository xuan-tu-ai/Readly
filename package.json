    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
